rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email is string && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data;
    }

    function isAuthorizedAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) ||
        request.auth.token.email.lower() in ['aboab411@gmail.com', 'mostafak80@gmail.com']
      );
    }

    function getAdminRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()))
        ? getUserData().role.lower()
        : (request.auth.token.email.lower() in ['aboab411@gmail.com', 'mostafak80@gmail.com'] ? 'owner' : 'editor');
    }

    function isOwner() {
      return isAuthorizedAdmin() && getAdminRole() == 'owner';
    }

    function isEditorOrOwner() {
      return isAuthorizedAdmin() && (getAdminRole() == 'owner' || getAdminRole() == 'editor');
    }

    function validTracking(data) {
      return data is map && data.keys().hasAll(['id','status','timestamp','updatedAt','expectedAt','total','items'])
        && data.keys().hasOnly(['id','status','timestamp','updatedAt','expectedAt','total','items'])
        && data.id is string && data.id.matches('KENO-[A-Z0-9-]{8,60}')
        && data.status in ['pending','paid','processing','delivered','cancelled']
        && data.timestamp is number && data.updatedAt is number
        && data.expectedAt is number && data.expectedAt >= 0
        && data.total is number && data.total >= 0 && data.total <= 10000000
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100;
    }

    // Orders Collection
    // - Public customers can create new orders with status 'pending'
    // - Only authorized admins can view, update statuses, or delete orders
    match /orders/{orderId} {
      function shortText(key, max) {
        return request.resource.data[key] is string && request.resource.data[key].size() <= max;
      }
      function validReceipt() {
        let r = request.resource.data.receipt;
        return (r == null && request.resource.data.hasReceipt == false) ||
          (r is map && request.resource.data.hasReceipt == true &&
           r.keys().hasOnly(['dataUrl','fileName','size']) &&
           r.dataUrl is string && r.dataUrl.size() <= 700000 &&
           r.dataUrl.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}') &&
           r.fileName is string && r.fileName.size() <= 200 &&
           r.size is number && r.size >= 0 && r.size <= 525000);
      }
      allow create: if request.resource.data.keys().hasAll(['id', 'timestamp', 'total', 'status'])
                    && request.resource.data.keys().hasOnly(['id','trackingToken','trackingSummary','reviewToken','serviceIds','timestamp','dateStr','type','items','total','paymentMethod','paymentMethodId','customerAccount','customerPhone','transferNumber','hasReceipt','receipt','notes','status','createdAt','updatedAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.id == orderId
                    && orderId.matches('KENO-[A-Z0-9-]{8,60}')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && shortText('dateStr', 100) && shortText('type', 20)
                    && shortText('paymentMethod', 300) && shortText('paymentMethodId', 80)
                    && shortText('customerAccount', 12000) && shortText('customerPhone', 40)
                    && shortText('transferNumber', 100) && shortText('notes', 2000)
                    && request.resource.data.reviewToken.matches('[a-f0-9]{48}')
                    && request.resource.data.serviceIds is list && request.resource.data.serviceIds.size() <= 100
                    && validReceipt()
                    && request.resource.data.timestamp is number
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.total <= 10000000
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 100
                    && (!('trackingToken' in request.resource.data) ||
                      (request.resource.data.trackingToken == '' && request.resource.data.trackingSummary == null) ||
                      (request.resource.data.trackingToken.matches('[a-f0-9]{48}')
                        && validTracking(request.resource.data.trackingSummary)
                        && request.resource.data.trackingSummary.id == orderId
                        && request.resource.data.trackingSummary.status == 'pending'
                        && getAfter(/databases/$(database)/documents/orderTracking/$(request.resource.data.trackingToken)).data == request.resource.data.trackingSummary));
      allow read: if isAuthorizedAdmin();
      allow update, delete: if isEditorOrOwner();
    }

    // Bearer links reveal a deliberately small projection. Private orders remain admin-only.
    match /orderTracking/{token} {
      function linkedOrder() {
        return getAfter(/databases/$(database)/documents/orders/$(request.resource.data.id)).data;
      }
      allow get: if token.matches('[a-f0-9]{48}');
      allow list: if isAuthorizedAdmin();
      allow create: if token.matches('[a-f0-9]{48}') && validTracking(request.resource.data)
        && linkedOrder().trackingToken == token
        && linkedOrder().status == request.resource.data.status
        && (isEditorOrOwner() || (request.resource.data.status == 'pending'
          && linkedOrder().createdAt == request.time
          && linkedOrder().trackingSummary == request.resource.data));
      allow update: if isEditorOrOwner() && validTracking(request.resource.data)
        && linkedOrder().trackingToken == token && linkedOrder().status == request.resource.data.status;
      allow delete: if isEditorOrOwner();
    }

    match /careRequests/{token} {
      allow create: if token.matches('[a-f0-9]{48}')
        && request.resource.data.keys().hasOnly(['id','kind','serviceId','planId','phone','consent','expiresAt','timestamp','status','createdAt'])
        && request.resource.data.id == token
        && request.resource.data.kind in ['availability','renewal']
        && request.resource.data.serviceId is string && request.resource.data.serviceId.size() > 0 && request.resource.data.serviceId.size() <= 80
        && request.resource.data.planId is string && request.resource.data.planId.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('[0-9]{8,16}')
        && request.resource.data.consent == true
        && request.resource.data.expiresAt is number && request.resource.data.expiresAt >= 0
        && request.resource.data.timestamp is number
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isEditorOrOwner();
      // The unguessable cancellation token allows revocation without exposing contact details.
      allow update: if (isEditorOrOwner() && request.resource.data.status in ['pending','done','cancelled']) ||
        (token.matches('[a-f0-9]{48}') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled');
    }

    match /careEvents/{eventId} {
      allow create: if eventId.matches('[a-f0-9]{48}')
        && request.resource.data.keys().hasOnly(['id','name','serviceId','step','timestamp','createdAt'])
        && request.resource.data.id == eventId
        && request.resource.data.name in ['service_view','checkout_step','cart_step','whatsapp_open','reorder']
        && request.resource.data.serviceId is string && request.resource.data.serviceId.size() <= 80
        && request.resource.data.step is string && request.resource.data.step.size() <= 3
        && request.resource.data.timestamp is number
        && request.resource.data.createdAt == request.time;
      allow read: if isAuthorizedAdmin();
      allow update, delete: if isOwner();
    }

    // The private claim is never exposed in the public review collection.
    match /reviewSubmissions/{reviewId} {
      function order() {
        return get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;
      }
      allow create: if request.resource.data.keys().hasOnly(['orderId','token','serviceId','name','rating','comment','createdAt'])
        && request.resource.data.orderId is string
        && request.resource.data.serviceId is string
        && reviewId == request.resource.data.orderId + '--' + request.resource.data.serviceId
        && request.resource.data.token is string && request.resource.data.token.size() == 48
        && order().status == 'delivered'
        && order().reviewToken == request.resource.data.token
        && request.resource.data.serviceId in order().serviceIds
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.comment is string && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 1500
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow read: if isAuthorizedAdmin();
      // Immutable submissions prevent changes to a customer's opinion during moderation.
      allow update, delete: if false;
    }
    match /reviews/{reviewId} {
      function submission() {
        return get(/databases/$(database)/documents/reviewSubmissions/$(reviewId)).data;
      }
      allow read: if true;
      allow create, update: if isEditorOrOwner()
        && request.resource.data.keys().hasOnly(['name','comment','rating','serviceId','timestamp'])
        && request.resource.data.name == submission().name
        && request.resource.data.comment == submission().comment
        && request.resource.data.rating == submission().rating
        && request.resource.data.serviceId == submission().serviceId
        && request.resource.data.timestamp == submission().createdAt.toMillis();
      allow delete: if isEditorOrOwner();
    }

    // Users / Admins Whitelist Collection
    // - Authenticated users can read to verify their own access
    // - Only the Owner can grant, edit, or revoke admin privileges
    match /users/{userEmail} {
      allow read: if isAuthenticated() && (userEmail == request.auth.token.email.lower() || isOwner());
      allow write: if isOwner();
    }

    // Services Catalog Collection
    // - Public read for all customers
    // - Write allowed for Content Editors and Owners
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isEditorOrOwner();
    }

    // Payment Methods Collection
    // - Public read for all customers
    // - Write allowed for Owners only
    match /paymentMethods/{methodId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Store Settings Collection (announcements, contact, social)
    // - Public read for all customers
    // - Write allowed for Owners only
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
