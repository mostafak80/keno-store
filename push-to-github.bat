@echo off
chcp 65001 > nul
echo ======================================================
echo    جارٍ رفع أحدث التعديلات إلى GitHub تلقائياً...
echo ======================================================
echo.

git add .
set /p commit_msg="اكتب وصف التعديل (أو اضغط Enter لكتابة وصف افتراضي): "
if "%commit_msg%"=="" set commit_msg=Update Keno Store - %date% %time%

git commit -m "%commit_msg%"
echo.
echo جارٍ الرفع إلى GitHub...
git push origin main

echo.
if %ERRORLEVEL% equ 0 (
    echo ======================================================
    echo    ✅ تم رفع التعديلات بنجاح إلى GitHub!
    echo ======================================================
) else (
    echo ======================================================
    echo    ❌ حدث خطأ أثناء الرفع، يرجى التأكد من الاتصال بالإنترنت.
    echo ======================================================
)

echo.
pause
